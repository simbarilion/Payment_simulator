# Каталог постоянного хранилища (в Docker Compose: /data)
DATA_DIR=data

# Имя файла SQLite внутри DATA_DIR
SQLITE_FILENAME=payments.db

# Базовый URL provider-simulator
PROVIDER_URL=http://localhost:8081

# Повторы вызова провайдера при 503 / сетевых ошибках
PROVIDER_MAX_ATTEMPTS=3
PROVIDER_RETRY_BASE_DELAY_SECONDS=0.2

# Приложение
APP_HOST=0.0.0.0
APP_PORT=8080
APP_DEBUG=false
LOG_LEVEL=INFO
